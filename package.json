{
  "name": "project-spec",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:mermaid": "find . -name \"*.md\" -exec grep -l \"mermaid\" {} \\; | xargs -n1 mmdc -i {} -o /dev/null",
    "lint": "npm run lint:md && npm run lint:mermaid"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.39.0",
    "@mermaid-js/mermaid-cli": "^10.12.0"
  }
}